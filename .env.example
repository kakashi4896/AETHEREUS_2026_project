# Example environment file for the CLPS Lunar Mission Browser
# Copy this to .env and update as needed.

APP_NAME=CLPS-Lunar-Mission-Browser
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO

# Example later-phase settings:
# HORIZONS_API_BASE_URL=https://ssd-api.jpl.nasa.gov
# HORIZONS_TIMEOUT_SECONDS=30
# DATA_CACHE_DIR=./data/cache
